jwt_secret_key              = ""
jwt_expiration_hours        = 2
db_connection_string        = "Host=<POSTGRES_FLEXIBLE_SERVER>;Port=5432;Database=oficina_db;Username=oficina_admin;******"
mock_database               = "false"
api_name                    = "oficina-auth-api"
